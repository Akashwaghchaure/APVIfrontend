# ========================================================
# Air Powervision India — Backend Environment Configuration
# ========================================================

# 1. Database Configuration (Optional)
# If provided, the backend connects to your MySQL server.
# If omitted or offline, the backend automatically uses the
# local persistent file database (data/inquiries-db.json).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=air_powervision

# 2. SMTP Email Gateway Configuration (Optional)
# If provided, the backend will dispatch real emails to both
# the duty engineering lead and a confirmation to the client.
# If omitted, it operates in Safe Logger Mode (logs in terminal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=inquiries@airpowervision.in
SMTP_PASS=your_app_password
CONTACT_RECEIVER_EMAIL=info@airpowervision.in
CONTACT_FROM_EMAIL="Air Powervision Desk" <inquiries@airpowervision.in>

# 3. Admin Security (Optional)
ADMIN_SECRET_KEY=
